# ?p=123 / ?page_id=123 links are handled by a small script on the homepage.
/feed/              /rss.xml            301
/feed               /rss.xml            301
/hero-header-v6-2/  /                   301
/blog/              /blog-articles/     301
/category/*         /blog-articles/     301
/tag/*              /blog-articles/     301
/author/*           /                   301
/wp-admin/*         /                   301
/wp-login.php       /                   301
/sitemap.xml        /sitemap-index.xml  301
/wp-sitemap.xml     /sitemap-index.xml  301
