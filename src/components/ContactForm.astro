---
// Netlify Forms: Netlify detects this form at deploy time and emails submissions.
// On another host, set `action` to a Formspree (or similar) endpoint instead.
---
<form name="contact" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="company" class="card space-y-5 p-6 sm:p-8">
  <input type="hidden" name="form-name" value="contact" />
  <p class="hidden"><label>Leave this empty: <input name="company" tabindex="-1" autocomplete="off" /></label></p>
  <h3 class="text-2xl font-semibold text-navy-800 dark:text-white">Send us a message</h3>
  <div class="grid gap-5 sm:grid-cols-2">
    <label class="block"><span class="mb-1.5 block text-sm font-semibold">First name <span class="text-accent-ink">*</span></span>
      <input name="first-name" required autocomplete="given-name" class="field" /></label>
    <label class="block"><span class="mb-1.5 block text-sm font-semibold">Last name <span class="text-accent-ink">*</span></span>
      <input name="last-name" required autocomplete="family-name" class="field" /></label>
  </div>
  <div class="grid gap-5 sm:grid-cols-2">
    <label class="block"><span class="mb-1.5 block text-sm font-semibold">Email address <span class="text-accent-ink">*</span></span>
      <input type="email" name="email" required autocomplete="email" class="field" /></label>
    <label class="block"><span class="mb-1.5 block text-sm font-semibold">Phone</span>
      <input type="tel" name="phone" autocomplete="tel" class="field" /></label>
  </div>
  <label class="block"><span class="mb-1.5 block text-sm font-semibold">Short description of your project <span class="text-accent-ink">*</span></span>
    <textarea name="message" required rows="5" class="field" placeholder="Tell us about your project, goals, timeline, and any specific requirements…"></textarea></label>
  <button type="submit" class="btn-primary w-full sm:w-auto">Send message</button>
</form>
