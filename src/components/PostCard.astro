---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<article class="card group flex flex-col overflow-hidden">
  <a href={`/${post.id}/`} class="flex flex-1 flex-col">
    {post.data.heroImage && <Image src={post.data.heroImage} alt="" widths={[400, 640, 800]} sizes="(min-width: 768px) 45vw, 90vw" class="aspect-[16/9] w-full object-cover" />}
    <div class="flex flex-1 flex-col p-6">
      <p class="text-xs font-bold uppercase tracking-wider text-accent-ink">{post.data.categories[0] ?? 'Article'} · <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time></p>
      <h2 class="mt-2 text-xl font-semibold leading-snug text-navy-800 group-hover:text-accent-ink dark:text-white">{post.data.title}</h2>
      <p class="mt-3 line-clamp-3 text-fg-muted">{post.data.description}</p>
      <span class="mt-auto pt-5 text-sm font-bold text-accent-ink">Read article →</span>
    </div>
  </a>
</article>
