---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found | Dolphin Design Works" description="That page could not be found." noindex>
  <section class="container-x max-w-2xl py-24 text-center">
    <p class="eyebrow">404</p>
    <h1 class="section-title mt-2 !text-5xl">Page not found</h1>
    <p class="mt-5 text-lg text-fg-muted">The page you're looking for has moved or no longer exists.</p>
    <div class="mt-8 flex justify-center gap-3"><a href="/" class="btn-primary">Home</a><a href="/blog-articles/" class="btn border border-line">Articles</a></div>
  </section>
</BaseLayout>
