---
// Posts and standalone pages both lived at the site root on WordPress (/my-post/), so one route serves both.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { site } from '../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const pages = await getCollection('pages');
  return [
    ...posts.map((entry) => ({ params: { slug: entry.id }, props: { kind: 'post' as const, entry } })),
    ...pages.map((entry) => ({ params: { slug: entry.id }, props: { kind: 'page' as const, entry } })),
  ];
}
type Props =
  | { kind: 'post'; entry: CollectionEntry<'blog'> }
  | { kind: 'page'; entry: CollectionEntry<'pages'> };

const { kind, entry } = Astro.props;
const { Content } = await render(entry);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

let related: CollectionEntry<'blog'>[] = [];
let ogImage: string | undefined;
let jsonLd: Record<string, unknown> | undefined;
if (kind === 'post') {
  const d = entry.data;
  related = (await getCollection('blog', (p) => !p.data.draft && p.id !== entry.id))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 2);
  if (d.heroImage) {
    const { getImage } = await import('astro:assets');
    ogImage = (await getImage({ src: d.heroImage, width: 1200, format: 'jpg' })).src;
  }
  jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.description,
    datePublished: d.pubDate.toISOString(),
    dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
    author: { '@type': 'Person', name: site.owner },
    publisher: { '@id': `${site.url}/#organization` },
    mainEntityOfPage: new URL(`/${entry.id}/`, site.url).toString(),
    ...(ogImage ? { image: new URL(ogImage, site.url).toString() } : {}),
  };
}
const title = kind === 'post'
  ? `${entry.data.title} | ${site.name}`
  : (entry.data as CollectionEntry<'pages'>['data']).seoTitle ?? `${entry.data.title} | ${site.name}`;
---
<BaseLayout title={title} description={entry.data.description} image={ogImage} type={kind === 'post' ? 'article' : 'website'} jsonLd={jsonLd}>
  {kind === 'post' ? (
    <article>
      <header class="bg-navy-900 pb-32 pt-14 text-white sm:pt-20">
        <div class="container-x max-w-3xl">
          <a href="/blog-articles/" class="text-sm font-semibold text-white/70 hover:text-brand">← All articles</a>
          <p class="mt-6 text-sm font-bold uppercase tracking-[0.18em] text-brand">{entry.data.categories.join(' · ')}</p>
          <h1 class="mt-3 text-4xl font-semibold leading-tight sm:text-5xl">{entry.data.title}</h1>
          <p class="mt-5 text-white/70">By {site.owner} · <time datetime={entry.data.pubDate.toISOString()}>{fmt(entry.data.pubDate)}</time></p>
        </div>
      </header>
      <div class="container-x max-w-3xl">
        {entry.data.heroImage && (
          <Image src={entry.data.heroImage} alt={entry.data.heroAlt ?? ''} widths={[640, 960, 1400]} sizes="(min-width: 768px) 720px, 92vw" class="-mt-24 aspect-[16/9] w-full rounded-2xl object-cover shadow-2xl" loading="eager" />
        )}
        <div class="prose prose-lg prose-slate dark:prose-invert prose-headings:font-display prose-headings:font-semibold prose-headings:text-navy-800 dark:prose-headings:text-white prose-a:text-accent-ink mx-auto py-12">
          <Content />
        </div>
        <aside class="mb-16 rounded-2xl bg-navy-800 p-8 text-white sm:p-10">
          <h2 class="text-2xl font-semibold">Need help with your website?</h2>
          <p class="mt-2 text-white/80">Get a free consultation and a detailed project estimate from a local Ohio web designer.</p>
          <a href="/#contact" class="btn-primary mt-6">Get a free quote</a>
        </aside>
      </div>
      {related.length > 0 && (
        <section class="bg-bg-muted py-16">
          <div class="container-x">
            <h2 class="section-title">More articles</h2>
            <div class="mt-8 grid gap-6 md:grid-cols-2">{related.map((p) => <PostCard post={p} />)}</div>
          </div>
        </section>
      )}
    </article>
  ) : (
    <article class="container-x max-w-3xl py-16 sm:py-20">
      <h1 class="section-title !text-4xl sm:!text-5xl">{entry.data.title}</h1>
      <div class="prose prose-slate dark:prose-invert prose-headings:font-display prose-headings:text-navy-800 dark:prose-headings:text-white prose-a:text-accent-ink mt-8 max-w-none">
        <Content />
      </div>
    </article>
  )}
</BaseLayout>
