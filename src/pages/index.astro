---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, heroPoints, services, process, projects, testimonials, whyChoose } from '../data/site';
import headshot from '../assets/uploads/2025-09-rick-headshot-gray-polo-home-office.png';
import monitor from '../assets/uploads/2025-09-monitor-with-logo.jpg';
import { getCollection } from 'astro:content';
const latest = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy-900 text-white">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(60rem_30rem_at_85%_-10%,rgba(247,111,0,0.28),transparent_60%),radial-gradient(40rem_30rem_at_-10%_110%,rgba(26,61,120,0.9),transparent_60%)]"></div>
    <div class="container-x relative grid items-center gap-12 py-16 sm:py-20 lg:grid-cols-[1.15fr_1fr] lg:py-28">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand">More than 20 years of experience</p>
        <h1 class="mt-4 text-5xl font-semibold leading-[1.05] sm:text-6xl lg:text-7xl">
          <span class="text-brand">Affordable</span> Web Design
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/80">We craft beautiful, professional websites tailored for small businesses, churches, and nonprofits. Get online with a stunning website that fits your budget and goals perfectly.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#contact" class="btn-primary">Get a free quote <Icon name="arrow" class="size-5" /></a>
          <a href="#projects" class="btn-ghost">See our work</a>
        </div>
        <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm font-semibold text-white/90">
          {heroPoints.map((p) => (
            <li class="flex items-center gap-2"><span class="grid size-6 place-items-center rounded-full bg-brand/20 text-brand"><Icon name="check" class="size-4" /></span>{p}</li>
          ))}
        </ul>
      </div>
      <div class="relative mx-auto w-full max-w-md lg:max-w-none">
        <div class="absolute -inset-3 rotate-2 rounded-[2rem] bg-brand/80"></div>
        <Image src={monitor} alt="A desktop monitor on a tidy desk showing the Dolphin Design logo" widths={[480, 720, 960]} sizes="(min-width: 1024px) 40vw, 90vw" class="relative aspect-[4/3] w-full rounded-[1.75rem] object-cover shadow-2xl" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <!-- Who we are -->
  <section id="who" class="py-20 sm:py-24">
    <div class="container-x grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="relative mx-auto w-full max-w-sm lg:max-w-none">
        <Image src={headshot} alt="Rick Metzler, founder of Dolphin Design Works, in his home office" widths={[400, 640, 900]} sizes="(min-width: 1024px) 40vw, 90vw" class="aspect-[4/5] w-full rounded-[2rem] object-cover object-top shadow-xl" />
        <div class="absolute -bottom-5 right-4 rounded-2xl bg-brand px-5 py-3 text-navy-950 shadow-lg sm:right-8">
          <p class="font-display text-3xl font-semibold leading-none">35+</p>
          <p class="text-xs font-bold uppercase tracking-wider">years in IT</p>
        </div>
      </div>
      <div>
        <p class="eyebrow">Who we are</p>
        <h2 class="section-title mt-2">Hi, I'm Rick Metzler</h2>
        <div class="mt-6 space-y-4 text-lg leading-relaxed text-fg-muted">
          <p>I'm a Pickerington, Ohio resident where I've lived with my wife and 4 children for over 30 years. With more than 35 years experience as a computer programmer in Central Ohio's IT community, I've built a solid foundation in technology.</p>
          <p>Back in the mid-2000s, I picked up website building as a hobby—a side interest that grew into something much bigger. Soon, I was crafting professional sites for local churches, nonprofits, and small businesses throughout Ohio.</p>
          <p>If you're a small business owner, church leader, or nonprofit looking for a website but unsure where to begin, I'd love to chat and explore how I can help bring your vision to life.</p>
        </div>
        <a href="#contact" class="mt-8 inline-flex items-center gap-2 font-bold text-accent-ink hover:underline">Let's talk about your project <Icon name="arrow" class="size-5" /></a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="bg-bg-muted py-20 sm:py-24">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="eyebrow">Our services</p>
        <h2 class="section-title mt-2">Everything your website needs, under one roof</h2>
        <p class="mt-4 text-lg text-fg-muted">Explore our full range of services designed to elevate your brand, enhance user experience, and drive measurable growth.</p>
      </div>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <li class="card group p-7 transition hover:-translate-y-1 hover:shadow-xl hover:shadow-navy-900/5">
            <span class="grid size-12 place-items-center rounded-xl bg-brand-soft text-brand-ink transition group-hover:bg-brand group-hover:text-navy-950 dark:bg-brand/15 dark:text-brand"><Icon name={s.icon} /></span>
            <h3 class="mt-5 text-xl font-semibold text-navy-800 dark:text-white">{s.title}</h3>
            <p class="mt-2 leading-relaxed text-fg-muted">{s.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Process -->
  <section id="how" class="py-20 sm:py-24">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Our process</p>
        <h2 class="section-title mt-2">How we work together</h2>
        <p class="mt-4 text-lg text-fg-muted">We've streamlined our process to be simple, transparent, and focused on delivering exceptional results that exceed your expectations.</p>
      </div>
      <ol class="mt-14 grid gap-6 lg:grid-cols-3">
        {process.map((step, i) => (
          <li class="card relative p-7 pt-9">
            <span class="absolute -top-5 left-7 grid size-10 place-items-center rounded-full bg-navy-800 font-display text-lg font-semibold text-white ring-4 ring-bg">{i + 1}</span>
            <div class="flex items-center gap-3">
              <Icon name={step.icon} class="size-7 text-accent-ink" />
              <h3 class="text-xl font-semibold text-navy-800 dark:text-white">{step.title}</h3>
            </div>
            <p class="mt-3 leading-relaxed text-fg-muted">{step.text}</p>
            <ul class="mt-5 space-y-2 border-t border-line pt-5 text-sm font-semibold">
              {step.points.map((p) => (<li class="flex items-center gap-2"><Icon name="check" class="size-4 text-accent-ink" />{p}</li>))}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="bg-navy-900 py-20 text-white sm:py-24">
    <div class="container-x">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <p class="text-sm font-bold uppercase tracking-[0.18em] text-brand">Recent projects</p>
          <h2 class="mt-2 text-3xl font-semibold sm:text-4xl">Work we're proud of</h2>
          <p class="mt-4 text-lg text-white/75">Take a look at some of our recent work for small businesses, churches, and nonprofits throughout Central Ohio and beyond.</p>
        </div>
      </div>
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((p, i) => (
          <li class={i >= 6 ? 'project-more hidden' : ''}>
            <a href={`https://${p.domain}`} target="_blank" rel="noopener" class="group block overflow-hidden rounded-2xl bg-navy-800 ring-1 ring-white/10 transition hover:ring-brand">
              <div class="overflow-hidden">
                <Image src={p.image} alt={`Homepage of the ${p.name} website`} widths={[400, 640, 800]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw" class="aspect-[16/10] w-full object-cover object-top transition duration-500 group-hover:scale-105" />
              </div>
              <div class="flex items-center justify-between gap-3 p-5">
                <div>
                  <h3 class="text-lg font-semibold">{p.name}</h3>
                  <p class="text-sm text-white/65">{p.domain}</p>
                </div>
                <Icon name="external" class="size-5 shrink-0 text-white/50 transition group-hover:text-brand" />
              </div>
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-10 text-center">
        <button type="button" id="more-projects" class="btn-ghost">Show all {projects.length} projects</button>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section id="clients" class="py-20 sm:py-24">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Testimonials</p>
        <h2 class="section-title mt-2">What our clients say</h2>
        <p class="mt-4 text-lg text-fg-muted">Don't just take our word for it. Here's what small businesses, churches, and nonprofits say about working with Dolphin Design Works.</p>
      </div>
      <ul class="mt-14 columns-1 gap-6 md:columns-2 lg:columns-3">
        {testimonials.map((t) => (
          <li class="card mb-6 break-inside-avoid p-7">
            <div class="flex items-center justify-between">
              <Icon name="quote" class="size-8 text-brand" />
              <span class="text-brand" aria-label="5 out of 5 stars">★★★★★</span>
            </div>
            <blockquote class="mt-4 leading-relaxed text-fg-muted">“{t.quote}”</blockquote>
            <p class="mt-5 font-bold text-navy-800 dark:text-white">{t.name}</p>
            <p class="text-sm text-fg-muted">{t.role}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Latest articles -->
  {latest.length > 0 && (
    <section class="bg-bg-muted py-20 sm:py-24">
      <div class="container-x">
        <div class="flex items-end justify-between gap-6">
          <div>
            <p class="eyebrow">From the blog</p>
            <h2 class="section-title mt-2">Latest articles</h2>
          </div>
          <a href="/blog-articles/" class="hidden font-bold text-accent-ink hover:underline sm:inline-flex sm:items-center sm:gap-2">All articles <Icon name="arrow" class="size-5" /></a>
        </div>
        <ul class="mt-10 grid gap-6 md:grid-cols-3">
          {latest.map((post) => (
            <li class="card group overflow-hidden">
              <a href={`/${post.id}/`} class="block">
                {post.data.heroImage && <Image src={post.data.heroImage} alt="" widths={[400, 640]} sizes="(min-width: 768px) 30vw, 90vw" class="aspect-[16/9] w-full object-cover" />}
                <div class="p-6">
                  <p class="text-xs font-bold uppercase tracking-wider text-accent-ink">{fmt(post.data.pubDate)}</p>
                  <h3 class="mt-2 text-lg font-semibold leading-snug text-navy-800 group-hover:text-accent-ink dark:text-white">{post.data.title}</h3>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Contact -->
  <section id="contact" class="py-20 sm:py-24">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Contact</p>
        <h2 class="section-title mt-2">Ready to start your project?</h2>
        <p class="mt-4 text-lg text-fg-muted">Let's discuss how we can help bring your vision to life. Get in touch for a free consultation and detailed project estimate.</p>
      </div>
      <div class="mt-12 grid gap-8 lg:grid-cols-[1.4fr_1fr]">
        <ContactForm />
        <div class="space-y-6">
          <div class="card p-7">
            <h3 class="text-2xl font-semibold text-navy-800 dark:text-white">Get in touch directly</h3>
            <ul class="mt-5 space-y-4">
              <li><a href={site.phoneHref} class="flex items-center gap-4 hover:text-accent-ink"><span class="grid size-11 place-items-center rounded-xl bg-brand-soft text-brand-ink dark:bg-brand/15 dark:text-brand"><Icon name="phone" class="size-5" /></span><span><span class="block text-sm text-fg-muted">Phone</span><span class="font-semibold">{site.phone}</span></span></a></li>
              <li><a href={`mailto:${site.email}`} class="flex items-center gap-4 hover:text-accent-ink"><span class="grid size-11 place-items-center rounded-xl bg-brand-soft text-brand-ink dark:bg-brand/15 dark:text-brand"><Icon name="mail" class="size-5" /></span><span class="min-w-0"><span class="block text-sm text-fg-muted">Email</span><span class="block break-all font-semibold">{site.email}</span></span></a></li>
              <li class="flex items-center gap-4"><span class="grid size-11 place-items-center rounded-xl bg-brand-soft text-brand-ink dark:bg-brand/15 dark:text-brand"><Icon name="pin" class="size-5" /></span><span><span class="block text-sm text-fg-muted">Location</span><span class="font-semibold">{site.location}</span></span></li>
              <li><a href={site.facebook} rel="noopener" class="flex items-center gap-4 hover:text-accent-ink"><span class="grid size-11 place-items-center rounded-xl bg-brand-soft text-brand-ink dark:bg-brand/15 dark:text-brand"><Icon name="facebook" class="size-5" /></span><span><span class="block text-sm text-fg-muted">Facebook</span><span class="font-semibold">Follow us {site.facebookHandle}</span></span></a></li>
            </ul>
          </div>
          <div class="rounded-2xl bg-navy-800 p-7 text-white">
            <h3 class="text-2xl font-semibold">Why choose Dolphin Design Works?</h3>
            <ul class="mt-5 space-y-3">
              {whyChoose.map((w) => (<li class="flex items-center gap-3"><span class="grid size-6 place-items-center rounded-full bg-brand text-navy-950"><Icon name="check" class="size-4" /></span>{w}</li>))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  const btn = document.getElementById('more-projects');
  btn?.addEventListener('click', () => {
    document.querySelectorAll('.project-more').forEach((el) => el.classList.remove('hidden'));
    btn.remove();
  });
</script>
