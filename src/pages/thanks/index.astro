---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
---
<BaseLayout title={`Thank you | ${site.name}`} description="Thanks for getting in touch." noindex>
  <section class="container-x max-w-2xl py-24 text-center">
    <p class="eyebrow">Message sent</p>
    <h1 class="section-title mt-2 !text-5xl">Thank you!</h1>
    <p class="mt-5 text-lg text-fg-muted">I've received your message and will get back to you within one business day. If it's urgent, call me at <a href={site.phoneHref} class="font-semibold text-accent-ink">{site.phone}</a>.</p>
    <a href="/" class="btn-primary mt-8">Back to home</a>
  </section>
</BaseLayout>
<script is:inline>try { window.fbq && fbq('track', 'Lead'); window.gtag && gtag('event', 'generate_lead'); } catch (e) {}</script>
